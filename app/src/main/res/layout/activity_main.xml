<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@color/nova_bg">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤖 Nova"
        android:textColor="@color/nova_text"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your personal assistant"
        android:textColor="@color/nova_muted"
        android:textSize="15sp"
        android:layout_marginBottom="14dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/nova_panel"
        android:padding="14dp">

        <TextView
            android:id="@+id/chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova: Hello! I'm ready.&#10;&#10;"
            android:textColor="@color/nova_text"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Talk to Nova..."
            android:textColor="@color/nova_text"
            android:textColorHint="@color/nova_muted"
            android:background="@android:color/transparent"
            android:singleLine="true"/>

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="@color/nova_text"
            android:background="@drawable/nova_button"/>
    </LinearLayout>

    <Button
        android:id="@+id/mic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎤 Voice Mode"
        android:textColor="@color/nova_text"
        android:background="@drawable/nova_button"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❓ Help"
        android:textColor="@color/nova_text"
        android:background="@drawable/nova_button"
        android:layout_marginTop="8dp"/>
</LinearLayout>
